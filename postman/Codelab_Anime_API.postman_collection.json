{
  "info": {
    "name": "Codelab Anime API (Studio Ghibli)",
    "description": "Koleksi pengujian endpoint Public REST API Anime Studio Ghibli untuk Codelab Modul 2 Praktikum Pemrograman Web.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All Anime Films (Digunakan di users.html)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "https://ghibliapi.vercel.app/films",
          "protocol": "https",
          "host": ["ghibliapi", "vercel", "app"],
          "path": ["films"]
        },
        "description": "Mengambil seluruh daftar film anime Studio Ghibli untuk dirender menjadi kartu visual di users.html."
      }
    },
    {
