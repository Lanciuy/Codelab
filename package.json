{
  "name": "modul-2-web-praktikum",
  "version": "1.0.0",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/css/main.css -o ./src/css/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./src/css/main.css -o ./src/css/output.css --watch",
    "test:api": "npx newman run postman/Codelab_Users_API.postman_collection.json -e postman/Modul2_Environment.postman_environment.json",
    "test:anime": "npx newman run postman/Codelab_Anime_API.postman_collection.json",
    "test:demo": "npx newman run postman/Demo_API.postman_collection.json -e postman/Modul2_Environment.postman_environment.json"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
